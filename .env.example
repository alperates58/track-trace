# --- COOLIFY & DEPLOYMENT CONFIGURATION ---
# Must be unique for each deployment.
# Use lowercase letters, numbers and hyphens.
DEPLOYMENT_ID=example

# Traefik routing hostnames (without protocol)
FRONTEND_HOST=track.example.com
API_HOST=track-api.example.com

# Application URLs (with protocol)
FRONTEND_URL=https://track.example.com
API_URL=https://track-api.example.com

# Examples:
# Lider:
#   DEPLOYMENT_ID=lider
#   FRONTEND_HOST=track.liderkozmetik.com
#   API_HOST=track-api.liderkozmetik.com
#   FRONTEND_URL=https://track.liderkozmetik.com
#   API_URL=https://track-api.liderkozmetik.com
#
# Alper:
#   DEPLOYMENT_ID=alper
#   FRONTEND_HOST=track.alperates.com.tr
#   API_HOST=track-api.alperates.com.tr
#   FRONTEND_URL=https://track.alperates.com.tr
#   API_URL=https://track-api.alperates.com.tr

# --- SYSTEM CONFIGURATION ---
PORT=8080
API_BASE_URL=https://track-api.example.com

# --- DATABASE CONFIGURATION ---
DB_HOST=track_trace_db
DB_PORT=5432
DB_NAME=track_trace
DB_USER=postgres
DB_PASSWORD=<change_me>

# --- SECURITY ---
JWT_SECRET=<change_me_min_32_chars>
JWT_EXPIRY_HOURS=24

# --- INITIAL SEED CONFIGURATION ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<change_me>
ADMIN_NAME=System Administrator

# --- APPLICATION PREFERENCES ---
MAX_UPLOAD_MB=100

# --- BUILD METADATA ---
APP_VERSION=v0.1.0-mvp
BUILD_DATE=2026-06-16
GIT_COMMIT_SHA=dev-sha
